<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bookshare</title>
    <%- include('modules/links') %>
    <link rel="stylesheet" href="/stylesheets/editBook.css" />
  </head>
  <body>
    <div class="index">
      <header>
        <nav class="web-navbar">
          <div class="row align-items-center nvbar">
            <div class="col">
              <button
                class="buttn mouse mx-2"
                onclick="window.location.href = '/'"
              >
                Inicio
              </button>
            </div>
            <button
              class="buttn mouse mx-2"
              onclick="window.location.href = '/back'"
            >
              Atrás
            </button>
          </div>
        </nav>
      </header>
      <main>
        <div class="container-fluid p-5">
          <h2 class="text-center">Editar libro</h2>
          <form
            action="/books/editBook/<%= book.book_id %>/<%= book.user_id %>"
            method="post"
            class="page-view"
            enctype="multipart/form-data"
          >
            <div class="row">
              <div class="col-4 img">
                <div class="mb-3">
                  <img
                    id="addImg"
                    src="/images/books/<%= book.picture?book.picture:'book.jpg' %>"
                    alt=""
                  />
                </div>
              </div>
              <div class="col-8 data">
                <div class="mb-3">
                  <label for="inputTitle" class="form-label"
                    >Título del libro</label
                  >
                  <input
                    type="text"
                    class="form-control"
                    id="inputTitle"
                    aria-describedby="titleHelp"
                    name="title"
                    value="<%= book.title %>"
                  />
                </div>
                <div class="mb-3">
                  <label for="inputAuthor_name" class="form-label"
                    >Nombre completo del autor</label
                  >
                  <input
                    type="text"
                    class="form-control"
                    id="inputAuthor_name"
                    aria-describedby="author_nameHelp"
                    name="author_name"
                    value="<%= book.author_name %>"
                  />
                </div>
                <div class="mb-3">
                  <label for="inputYear_written" class="form-label"
                    >Año de publicación</label
                  >
                  <input
                    type="text"
                    class="form-control"
                    id="inputYear_written"
                    aria-describedby="year_writtenHelp"
                    name="year_written"
                    value="<%= book.year_written %>"
                  />
                  <p class="text-danger">
                    <%= typeof messageYear != 'undefined' ? messageYear : null
                    %>
                  </p>
                </div>
                <div class="mb-3">
                  <label for="review" class="form-label">Review</label>
                  <textarea
                    class="form-control"
                    id="review"
                    aria-describedby="reviewHelp"
                    name="review"
                  >
<%= book.review %></textarea
                  >
                </div>
                <div class="mb-3">
                  <label for="publisher" class="form-label">Editorial</label>
                  <input
                    type="text"
                    class="form-control"
                    id="publisher"
                    aria-describedby="publisherHelp"
                    name="publisher"
                    value="<%= book.publisher %>"
                  />
                </div>
                <div class="mb-3">
                  <label for="rating" class="form-label"></label>
                  <div class="starrating">
                    <input type="radio" id="star5" name="rating" value="5" />
                    <label for="star5" title="5 estrellas">★</label>
                    <input type="radio" id="star4" name="rating" value="4" />
                    <label for="star4" title="4 estrellas">★</label>
                    <input type="radio" id="star3" name="rating" value="3" />
                    <label for="star3" title="3 estrellas">★</label>
                    <input type="radio" id="star2" name="rating" value="2" />
                    <label for="star2" title="2 estrellas">★</label>
                    <input type="radio" id="star1" name="rating" value="1" />
                    <label for="star1" title="1 estrella">★</label>
                  </div>
                </div>
                <p class="text-danger">
                  <%= typeof messageRating != 'undefined' ? messageRating : null
                  %>
                </p>
                <div class="d-flex gap-2 mb-2">
                  <button type="submit" class="buttn mouse">Actualizar</button>
                  <button
                    type="button"
                    class="buttn mouse"
                    onclick="
                      window.location.href =
                        '/users/profile/<%= book.user_id %>'
                    "
                  >
                    Cancelar
                  </button>
                  <label for="imgAdded" class="form-label buttn mouse mx-5">
                    Editar imagen</label
                  ><input
                    type="file"
                    class="form-control"
                    id="imgAdded"
                    name="img"
                    hidden
                  />
                </div>
              </div>
            </div>
          </form>
        </div>
      </main>
      <%- include('modules/scripts') %>
    </div>
  </body>
</html>
