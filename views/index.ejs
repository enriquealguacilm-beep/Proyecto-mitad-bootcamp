<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Usuarios</title>
    <%- include('modules/links') %>
  </head>
  <body>
    <header><%- include('modules/navbar') %></header>
    <main>
      <h1>Todos los usuarios</h1>

       <div class="d-flex flex-wrap justify-content-center gap-3">
       
       <% users.forEach((elem) =>{ %>

        <div class="card" style="width: 18rem" onclick="window.location.href='/users/profile/<%= elem.user_id %>'">
          <img src="/images/users/<%= elem.avatar?elem.avatar:'user.jpg'%> " 
          class="card-img-top" alt="" />
          <div class="card-body">
            <h5 class="card-title"> <%= elem.name %></h5>
            <p class="card-text">
              <%= elem.last_name %>
            </p>
            <p class="card-text">
              <%= elem.email %>
            </p>
            
            
          </div>
        </div>

     <% }) %>

      </div>

      <h2>Últimas rewiews</h2>
       <div class="d-flex flex-wrap justify-content-center gap-3">
       
       <% reviews.forEach((rev) =>{ %>

        <div class="card" style="width: 18rem">
          <img src="/images/users/<%= rev.avatar?rev.avatar:'user.jpg'%> " 
          class="card-img-top" alt="" />
          <div class="card-body">
            <h5 class="card-title"> <%= rev.name %></h5>
            <p class="card-text">
              <%= rev.last_name %>
            </p>
            <p class="card-text">
              <%= rev.title %>
            </p>
            <p class="card-text rating">
              <%= rev.rating %>
            </p>
            <a href="/users/profile/<%= rev.user_id %>" class="btn btn-primary">Ver perfil</a>
            
          </div>
        </div>

     <% }) %>

      </div>
    </main>
    <%- include('modules/scripts') %>
  </body>
</html>
