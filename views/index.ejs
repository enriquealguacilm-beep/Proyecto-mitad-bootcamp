<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Usuarios</title>
    <%- include('modules/links') %>
    <link rel="stylesheet" href="/stylesheets/index.css">
  </head>
  <body>
    <div class="index">
      <header><%- include('modules/navbar') %></header>
      <main>
        <section class="section-community container-fluid">
          <h2 id="community">Nuestra comunidad</h2>
           <div class="row justify-content-center gap-5 py-5 px-3">
           <% users.forEach((elem) =>{ %>
            <div class="col-2 user-card mouse"  onclick="window.location.href='/users/profile/<%= elem.user_id %>'">
              <img src="/images/users/<%= elem.avatar?elem.avatar:'user.jpg'%> "
              class="card-img-top" alt="" />
              <div class="user-card-body">
                <h5 class="user-card-title"> <%= elem.name %> <%= elem.last_name %></h5>
                <p>
                  <%= elem.preferences %>
                </p>
                <p>
                  <%= elem.email %>
                </p>
              </div>
            </div>
                 <% }) %>
          </div>
        </section>
        <section class="section-reviews container-fluid">
          <h2>Actividad reciente</h2>
           <div class="d-flex flex-wrap justify-content-center gap-2">
           <% reviews.forEach((rev) =>{ %>
            <div class="row review-card mouse" onclick="window.location.href='/users/profile/<%= rev.user_id %>'" >
              <img src="/images/users/<%= rev.avatar?rev.avatar:'user.jpg'%> "
              class="col" alt="" />
              <div class="col">
                <h5 class="card-title"> <%= rev.name %></h5>
                <p class="">
                  <%= rev.last_name %>
                </p>
                <p class="">
                  <%= rev.title %>
                </p>
                <p class=" rating">
                  <%= rev.rating %>
                </p>
                <a  class="btn btn-primary">Ir al perfil</a>
              </div>
            </div>
                 <% }) %>
        </section>
      </main>
      <%- include('modules/scripts') %>
    </div>
  </body>
</html>
