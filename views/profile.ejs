<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Perfil de <%= `${user.name} ${user.last_name}` %></title>
    
    <%- include('modules/links') %>
    <link rel="stylesheet" href="/stylesheets/profile.css">
    
     
  </head>
  <body>
    <div class="index"> <header>
          <nav class="web-navbar">
            <div class="row align-items-center  nvbar">
              <div class="col-12 col-xl-6 d-flex gap-2">
                <button class="buttn mouse  mx-xl-2" onclick="window.location.href='/'">Inicio</button>
              <% if (isOwner) { %>
              <button id="open-modal" type="button" class="buttn mouse ">Añadir libro</button>
              <% } %>
        
        
            </div>
            <div class="divider"></div>
            <div class="col-12 col-xl-6 d-flex gap-2 justify-content-end">
            <% if (login == false) { %>
            <button class="buttn mouse " onclick="window.location.href='/users/login'">Log in</button>
            <button class="buttn mouse me-2 mx-xl-2" onclick="window.location.href='/back'">Atrás</button>
           <% } else  if (isOwner == true){ %>
             <button class="buttn mouse " onclick="window.location.href='/users/logout'">Log out</button>
             <button class="buttn mouse me-2 mx-xl-2" onclick="window.location.href='/back'">Atrás</button>
          <% } else { %>
            <button class="buttn mouse " onclick="window.location.href='/users/profile/<%= getLoginId %>'">Mi perfil</button>
            <button class="buttn mouse me-2 mx-xl-2" onclick="window.location.href='/back'">Atrás</button>
           <% } %>
            </div>
            </div>
          </nav>
        </header>
      <div class="index-small">
       
        <main>
        
        
          <div class="container-xxl">
            <div class="row profile">
              <div class="col-12 col-xl-4 text-center ">
                <img
                  class="g-5"
                  src="/images/users/<%= user.avatar?user.avatar:'user.jpg'%> "
                  alt=""
                />
              </div>
              <div class="col align-content-center">
                <h1><%= `${user.name} ${user.last_name}` %></h1>
                <h3><span class="fw-bold">E-mail:</span > <span class="text-black"><%= user.email %></span></h3>
                <h3><span class="fw-bold">Preferencias:</span> <span class="text-black"><%= user.preferences %></span></h3>
                <% if (isOwner == false) { %>
        
           <% } else { %>
             <button class="buttn mouse ms-3 " onclick="window.location.href='/users/editUser/<%= user.user_id %>'">Editar</button>
             <button class="buttn mouse ms-3  red " onclick="window.location.href='/users/deleteUser/<%= user.user_id %>'">Eliminar usuario</button>
          <% } %>
        
              </div>
            </div>
           </div>
           <div class="container-xxl line"></div>
           <div class="container-xxl py-5">
            <% if(resultBooks.length > 0) {  %>
              <h2 id="books" class="text-center p-4">Libros</h2>
              <div class="">
                <% resultBooks.forEach((elem) =>{ %>
        
                <div class="book">
                  <% if (isOwner) { %>
        
                  <div class="col align-content-center text-center pt-3">
                    <a class="buttn mouse m-3  " href="/books/editBook/<%= elem.book_id %>">Editar</a>
                    <a class="buttn mouse red m-3 " href="/books/delete/<%= elem.book_id %>/<%= elem.user_id %>">Borrar</a>
                  </div>
        
                  <%  } %>
                  <div class="row p-2">
                      <div class="col-12 col-xl-6 text-center align-content-center">
                        <img src="/images/books/<%= elem.picture?elem.picture:'book.jpg'%> "
                        class="" alt="" />
                      </div>
                    <div class="col-12 col-xl-6   data ">
                      <div class="">
                        <h5 class=""> <%= elem.title %></h5>
                        <p>
                          <span class="fw-bold">Autor: </span> <%= elem.author_name %>
                        </p>
                        <p>
                          <span class="fw-bold">Género: </span> <%= elem.genre %>
                        </p>
                        <p>
                          <span class="fw-bold">Año de publicación: </span> <%= elem.year_written %>
                        </p>
                        <p>
                          <span class="fw-bold">Editorial: </span> <%= elem.publisher %>
                        </p>
                        <p class="rating">
                          <%= elem.rating %>
                        </p>
                      </div>
        
                  </div>
        
                  </div>
                  <div class="container-xxl ">
                    <div class="row review">
                      <div class="col">
                        <h2>Rewiew</h2>
                        <p><%= elem.review %></p>
                      </div>
                  </div>
                  </div>
                </div>
        
                <%  }) %>
              </div>
              <% } else { %>
        
                <div class="not-found">
                  <h3>No se encontraron libros</h3>
                  <img src="/images/assets/not-found.jpg" alt="">
                </div>
        
              <% } %>
        
                <dialog closedby="any" id="modal"  ><button id="close-modal" type="button"></button>
                  <%- include('modules/formNewReview') %>
                </dialog>
          </div>
        </main>
           <%- include('modules/scripts') %>
      </div>
    </div>
  </body>
</html>
