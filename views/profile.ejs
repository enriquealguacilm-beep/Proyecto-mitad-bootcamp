<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Perfil de <%= `${user.name} ${user.last_name}` %></title>
    
    <%- include('modules/links') %>
     
  </head>
  <body>
    <header><%- include('modules/navbar') %></header>
    <main>
      <h1><%= `${user.name} ${user.last_name}` %></h1>
      <div class="container-xxl">
        <div class="row">
          <div class="col text-center">
            <img
              class=""
              src="/images/users/<%= user.avatar?user.avatar:'user.jpg'%> "
              alt=""
            />
          </div>
          <div class="col align-content-center">
          
            <h3><span class="fw-bold">E-mail:</span> <%= user.email %></h3>
            <h3><span class="fw-bold">Preferencias:</span> <%= user.preferences %></h3>
            <div class="text-center">
              <button class="btn btn-secondary" onclick="window.location.href='/books/newBook/<%= user.user_id %>'">Añadir libro</button>
               <button class="btn btn-secondary" onclick="window.location.href='/'">Atrás</button>
            </div>
          </div>
        </div>
      <div class="mb-5">
          <h2 class="text-center p-4">Libros</h2>

          <div class="">
            <% resultBooks.forEach((elem) =>{ %>
              
            <div class="row">
              
                <div class="col text-center">
                  <img src="/images/books/<%= elem.picture?elem.picture:'user.jpg'%> "
                  class="" alt="" />
                </div>
              <div class="col">
                <h5 class=""> <%= elem.title %></h5>
                <p>
                  <span class="fw-bold">Autor: </span><%= elem.author_name %>
                </p>
                <p>
                  <span class="fw-bold">Género: </span><%= elem.genre %>
                </p>
                <p>
                  <span class="fw-bold">Año de publicación: </span><%= elem.year_written %>
                </p>
                <p>
                  <span class="fw-bold">Editorial: </span><%= elem.publisher %>
                </p>
                <p class="rating">
                  <%= elem.rating %>
                </p>
            </div>
              
              
            </div>
            <div class="row">
              <div class="col">
                <h2>Rewiew</h2>
                <p><%= elem.review %></p>
              </div>
              
            </div>
                    
            <%  }) %>
          </div>
        </div>
      </div>
    </main>
   <%- include('modules/scripts') %>
  </body>
</html>
