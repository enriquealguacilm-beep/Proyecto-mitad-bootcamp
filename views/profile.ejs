<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Perfil de <%= `${user.name} ${user.last_name}` %></title>
    
    <%- include('modules/links') %>
    <link rel="stylesheet" href="/stylesheets/profile.css">
     
  </head>
  <body>
    <div class="index">
      <header>
        <nav class="web-navbar">
          <div class="row align-items-center  nvbar">
            <div class="col ">
              <button class="buttn mouse mx-2" onclick="window.location.href='/'">Inicio</button>
            <button id="open-modal" type="button" class="buttn mouse">Añadir libro</button>
            
          </div>
          <button class="buttn mouse mx-2" onclick="window.location.href='/back'">Atrás</button>
          
          </div>
        </nav>
      </header>
      <main>
        
        <div class="container-xxl">
          <div class="row profile">
            <div class="col-12 col-xl-4 text-center ">
              <img
                class="g-5"
                src="/images/users/<%= user.avatar?user.avatar:'user.jpg'%> "
                alt=""
              />
            </div>
            <div class="col align-content-center">
              <h1><%= `${user.name} ${user.last_name}` %></h1>
              <h3><span class="fw-bold">E-mail:</span> <%= user.email %></h3>
              <h3><span class="fw-bold">Preferencias:</span> <%= user.preferences %></h3>
              
            </div>
          </div>
         </div>
         <div class="container-xxl line"></div>
         <div class="container-fluid py-5">

          <% if(resultBooks.length > 0) {  %>
            <h2 id="books" class="text-center p-4">Libros</h2>
            <div class="">
              <% resultBooks.forEach((elem) =>{ %>
      
              <div class="book">
                <div class="row p-2">
                    <div class="col-12 col-xl-4 text-center align-content-center">
                      <img src="/images/books/<%= elem.picture?elem.picture:'user.jpg'%> "
                      class="" alt="" />
                    </div>
                  <div class="col-12 col-xl-3  align-content-center data ">
                    <h5 class=""> <%= elem.title %></h5>
                    <p>
                      <span class="fw-bold">Autor: </span><%= elem.author_name %>
                    </p>
                    <p>
                      <span class="fw-bold">Género: </span><%= elem.genre %>
                    </p>
                    <p>
                      <span class="fw-bold">Año de publicación: </span><%= elem.year_written %>
                    </p>
                    <p>
                      <span class="fw-bold">Editorial: </span><%= elem.publisher %>
                    </p>
                    <p class="rating">
                      <%= elem.rating %>
                    </p>
                
                </div>
                <div class="col align-content-center text-center">
                  <a class="buttn mouse" href="/books/editBook/<%= elem.book_id %>">Editar</a>
                </div>
                 <div class="col align-content-center">
                  <a class="buttn mouse red" href="/books/delete/<%= elem.book_id %>/<%= elem.user_id %>">Borrar</a>
                </div>
                </div>
                <div class="container-xxl ">
                  <div class="row review">
                    <div class="col">
                      <h2>Rewiew</h2>
                      <p><%= elem.review %></p>
                    </div>
                </div>
                </div>
              </div>
      
              <%  }) %>
            </div>

            <% } else { %>
              
              <div class="not-found">
                <h3>No se encontraron libros</h3>
                <img src="/images/assets/not-found.jpg" alt="">
              </div>
            
            <% } %>
            
              <dialog id="modal"><button id="close-modal" type="button"></button>
                <%- include('modules/formNewReview') %>
              </dialog>
          
        </div>
      </main>
         <%- include('modules/scripts') %>
    </div>
  </body>
</html>
