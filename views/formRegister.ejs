<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bootstrap demo</title>
    <%- include('modules/links') %>
  </head>
  <body>
    <header><%- include('modules/navbar') %></header>
    <main>
      <form
        action="/users/register"
        method="post"
        class="w-25 border border-black rounded-4 p-3 m-5"
        enctype="multipart/form-data"
      >
        <h2>Formulario de registro</h2>
        <div class="mb-3">
          <label for="imgAdded" class="form-label"
            ><img
              id="addImg"
              style="width: 200px"
              src="/images/assets/add-user.jpg"
              alt=""
          /></label>
          <input
            type="file"
            class="form-control"
            id="imgAdded"
            name="img"
            hidden
          />
        </div>
        <div class="mb-3">
          <label for="inputName" class="form-label">Nombre</label>
          <input
            type="text"
            class="form-control"
            id="inputName"
            aria-describedby="nameHelp"
            name="name"
            value="<%= formValues?formValues.name:'' %>"
          />
        </div>
        <div class="mb-3">
          <label for="inputLast_name" class="form-label">Apellidos</label>
          <input
            type="text"
            class="form-control"
            id="inputLast_name"
            aria-describedby="lastnameHelp"
            name="last_name"
            value="<%= formValues?formValues.last_name:'' %>"
          />
        </div>
        <div class="mb-3">
          <label for="inputEmail" class="form-label">Email</label>
          <input
            type="email"
            class="form-control"
            id="inputEmail"
            aria-describedby="emailHelp"
            name="email"
            value="<%= formValues?formValues.email:'' %>"
          />
        </div>
        <div class="mb-3">
          <label for="inputPassword" class="form-label">Password</label>
          <input
            type="password"
            class="form-control"
            id="inputPassword"
            name="password"
          />
        </div>

        <div class="mb-3">
          <label class="form-label">Preferencias (opcional)</label>

          <div class="row">
            <div class="col">
              <div class="form-check">
                <input
                  class="form-check-input preference"
                  type="checkbox"
                  value="Drama"
                  id="drama"
                />
                <label class="form-check-label" for="drama">Drama</label>
              </div>
              <div class="form-check">
                <input
                  class="form-check-input preference"
                  type="checkbox"
                  value="Fantasía"
                  id="fantasia"
                />
                <label class="form-check-label" for="fantasia">Fantasía</label>
              </div>
              <div class="form-check">
                <input
                  class="form-check-input preference"
                  type="checkbox"
                  value="Poesía"
                  id="poesia"
                />
                <label class="form-check-label" for="poesia">Poesía</label>
              </div>
              <div class="form-check">
                <input
                  class="form-check-input preference"
                  type="checkbox"
                  value="Terror"
                  id="terror"
                />
                <label class="form-check-label" for="terror">Terror</label>
              </div>
            </div>
            <div class="col">
              <div class="form-check">
                <input
                  class="form-check-input preference"
                  type="checkbox"
                  value="Juvenil"
                  id="juvenil"
                />
                <label class="form-check-label" for="juvenil">Juvenil</label>
              </div>
              <div class="form-check">
                <input
                  class="form-check-input preference"
                  type="checkbox"
                  value="Ciencia ficción"
                  id="ciencia_ficcion"
                />
                <label class="form-check-label" for="ciencia_ficcion"
                  >Ciencia ficción</label
                >
              </div>
              <div class="form-check">
                <input
                  class="form-check-input preference"
                  type="checkbox"
                  value="novela policíaca"
                  id="novela_policíaca"
                />
                <label class="form-check-label" for="novela_policíaca"
                  >Novela policíaca</label
                >
              </div>
              <div class="form-check">
                <input
                  class="form-check-input preference"
                  type="checkbox"
                  value="Literatura LGBT+"
                  id="literatura_lgbt"
                />
                <label class="form-check-label" for="literatura_lgbt"
                  >Literatura LGBT+</label
                >
              </div>
            </div>
          </div>

          <input hidden name="preferences" id="inputPreferences" value="" />
        </div>

        <p class="text-danger">
          <%= typeof message != 'undefined' ? message: null %>
        </p>
        <div class="d-flex gap-2 mb-2">
          <button type="submit" class="btn btn-primary">Submit</button>
          <button
            type="button"
            class="btn btn-primary"
            onclick="window.location.href = '/'"
          >
            Cancelar
          </button>
        </div>
      </form>
    </main>
    <%- include('modules/scripts') %>
  </body>
</html>
